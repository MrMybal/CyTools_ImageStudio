{
  "schemaVersion": 1,
  "protocolVersion": "1.0",
  "id": "cy.tools.imagestudio",
  "name": "CyTools_ImageStudio",
  "version": "0.1.0",
  "vendor": "Cyberalien",
  "author": "Cyberalien",
  "description": "AI image generation and editing with local or remote ComfyUI, an inpainting canvas, ControlNet, LoRA training, and MCP automation.",
  "license": "AGPL-3.0-only",
  "licenseUrl": "https://spdx.org/licenses/AGPL-3.0-only.html",
  "repository": "https://github.com/MrMybal/CyTools_ImageStudio",
  "executable": "runtime/python/Scripts/python.exe app/tool.py",
  "standaloneExecutable": "CyTools_ImageStudio.exe",
  "categories": [
    "image"
  ],
  "tags": [
    "ComfyUI",
    "image-generation",
    "ControlNet",
    "LoRA"
  ],
  "capabilities": [
    "jobs",
    "cancellation",
    "text-to-image",
    "image-to-image",
    "inpainting",
    "workflow",
    "lora-training"
  ],
  "backends": [],
  "interfaces": [
    "ImGui",
    "CLI",
    "JSONL",
    "HTTP",
    "MCP"
  ],
  "platforms": [
    {
      "os": "Windows",
      "architecture": "x64",
      "status": "Experimental",
      "computeBackends": [
        "CPU",
        "CUDA"
      ]
    },
    {
      "os": "Linux",
      "architecture": "x64",
      "status": "Experimental",
      "computeBackends": [
        "CPU",
        "CUDA"
      ]
    }
  ],
  "runtimeRequirements": [],
  "concurrency": {
    "policy": "Sequential",
    "maxWorkers": 1
  },
  "operations": [
    {
      "id": "studio_status",
      "name": "Studio status",
      "description": "Read local backend configuration and model search paths.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "supportedBackends": [],
      "permissions": [],
      "resourceRequirements": {
        "ramBytes": 33554432
      },
      "canRunAsync": true,
      "canCancel": true,
      "supportsProgress": false
    },
    {
      "id": "inspect_backend",
      "name": "Inspect ComfyUI",
