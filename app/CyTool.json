    {
      "id": "train_lora",
      "name": "Train LoRA",
      "description": "Train from captioned images using native nodes on an ImageStudio-launched ComfyUI.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "description": "Configured ComfyUI profile. Omit for the studio default.",
            "enum": [
              "managed",
              "existing",
              "local",
              "remote"
            ]
          },
          "timeout": {
            "type": "integer",
            "default": 3600,
            "minimum": 15,
            "maximum": 86400,
            "description": "ComfyUI execution deadline in seconds."
          },
          "family": {
            "type": "string",
            "description": "Select the graph architecture matching the weights.",
            "enum": [
              "checkpoint",
              "flux",
              "flux2",
              "qwen",
              "qwen_edit",
              "sd3"
            ],
            "default": "checkpoint"
          },
          "checkpoint": {
            "type": "string",
            "description": "Exact checkpoint name from inspect_backend."
          },
          "diffusion": {
            "type": "string",
            "description": "Exact diffusion model name from inspect_backend."
          },
          "encoder": {
            "type": "string",
            "description": "Exact encoder. FLUX.1 takes CLIP-L here."
          },
          "encoder2": {
            "type": "string",
            "description": "FLUX.1 T5 encoder."
          },
          "vae": {
            "type": "string",
            "description": "Exact VAE name from inspect_backend."
          },
          "dtype": {
            "type": "string",
            "description": "",
            "enum": [
              "default",
              "fp8_e4m3fn",
              "fp8_e4m3fn_fast",
              "fp8_e5m2"
            ],
            "default": "default"
          },
          "encoder_device": {
            "type": "string",
            "description": "",
            "enum": [
              "default",
              "cpu"
            ],
            "default": "default"
          },
          "dataset": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "image": {
                  "type": "string",
                  "description": "Path on the ImageStudio host, imported automatically.",
                  "minLength": 1,
                  "x-cy-kind": "Image"
                },
                "caption": {
                  "type": "string",
                  "description": "Training caption.",
                  "maxLength": 2000,
                  "default": ""
                }
              },
              "required": [
                "image"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 256
          },
          "steps": {
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 100000
          },
          "rank": {
            "type": "integer",
            "default": 8,
            "minimum": 1,
            "maximum": 128
          },
          "learning_rate": {
            "type": "number",
            "default": 0.0005,
            "minimum": 1e-07,
            "maximum": 1.0
          },
          "batch_size": {
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "maximum": 32
          },
          "grad_accumulation_steps": {
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "maximum": 1024
          },
          "optimizer": {
            "type": "string",
            "description": "",
            "enum": [
              "AdamW",
              "Adam",
              "SGD",
              "RMSprop"
            ],
            "default": "AdamW"
          },
          "seed": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "training_dtype": {
            "type": "string",
            "description": "",
            "enum": [
              "bf16",
              "fp32",
              "none"
            ],
            "default": "bf16"
          },
          "gradient_checkpointing": {
            "type": "boolean",
            "default": true
